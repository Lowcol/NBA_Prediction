FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ scripts/
COPY serving/ serving/

# Bake in the trained model + current-season stats (both git-tracked) so the image
# is self-contained: no volume mount or dvc pull needed to serve predictions.
COPY NBAdata/monthly_stats/ NBAdata/monthly_stats/
COPY NBAdata/best_model.pkl NBAdata/scaler.pkl NBAdata/

EXPOSE 8000

ENTRYPOINT ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "serving/api"]
